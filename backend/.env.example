# Port (Render assigns this automatically, default: 5000)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/balancesheet?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL for CORS (e.g. https://your-frontend.vercel.app)
CLIENT_URL=https://your-frontend.vercel.app
